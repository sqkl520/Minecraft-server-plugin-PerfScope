<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>cn.perfscope</groupId>
    <artifactId>PerfScope</artifactId>
    <version>1.2.1</version>
    <packaging>jar</packaging>

    <name>PerfScope</name>
    <description>高性能服务器性能监测插件 - 实时监控TPS/MSPT/实体/区块/内存等</description>

    <licenses>
        <license>
            <name>GNU Affero General Public License v3.0</name>
            <url>https://www.gnu.org/licenses/agpl-3.0.html</url>
        </license>
    </licenses>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
          可复现构建（v1.3.0 门禁前置）：固定 jar 内所有条目的时间戳。

          不加这一项时，两次 `mvn clean package`（源码零改动）产出的 jar sha256 不同 ——
          zip 条目会带上各自的当前时间。实测：43abdb54… vs a80088b3…，`diff -r` 证明内容
          完全一致，差异只在 zip 元数据。

          后果：「归档 JAR 与源码一致」这条验收永远达不成，而它正是 1.2.1 事故
          （发布包落后 6 个提交、缺整个 i18n）的唯一防线。

          具体时间由 CI 传 `-Dproject.build.outputTimestamp=<ISO8601>`（见 .github/workflows/build.yml），
          本地不加参数时用下面这个固定值 —— 目的是「确定性」而不是「真实构建时间」。
        -->
        <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>
    </properties>

    <repositories>
        <!-- 专注 Paper 系：仅保留 PaperMC 仓库，移除 SpigotMC 快照仓库 -->
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Paper API (provided) - Paper 系服务端 API；传递提供 Adventure (net.kyori)，无需显式声明 -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.20.4-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <!-- Gson (provided) - 服务端自带，仅报告 JSON 生成用，P0-11 -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
            <scope>provided</scope>
        </dependency>
        <!-- bStats 匿名统计 (compile → 由 maven-shade-plugin 打包并 relocate，见 build 段注释)；
             传递依赖 bstats-base 一并打包。自包含遥测库，不与平台 API 做签名级互操作 -->
        <dependency>
            <groupId>org.bstats</groupId>
            <artifactId>bstats-bukkit</artifactId>
            <version>3.2.1</version>
        </dependency>
        <!--
          src/test 的回归测试网（2026-11-04）：此前仓库零单测，五波次审计的所有验证
          都靠仓库外临时探针，改一行代码后无法重跑。JUnit 5.10.1 + surefire 3.2.5
          是本环境离线仓库里已齐备的一组（CI 会走 Maven Central，版本无特殊要求）。

          这些 jar 全部是 test scope，不进 shade 产物：maven-shade-plugin 的
          artifactSet 只纳入 org.bstats 两个 artifact，且测试依赖不参与 runtime。
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <!-- 锐评 B 论点 10：统一 release 编译（替代 source/target），
                         防止在 JDK21 上误链接 java.version(17) 以上的 API -->
                    <release>${java.version}</release>
                </configuration>
            </plugin>
            <!-- 2026-11-04：补上显式 surefire 版本。CI 的 build.yml 检测到 src/test 后
                 会跑 `mvn test`；不钉版本时 Maven 用默认的 2.12.4，它不认识 JUnit 5，
                 会把测试文件全部静默跳过（红队 B4 同款「看起来绿其实没跑」形状）。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <!-- maven-shade-plugin（回归仅服务 bStats 匿名统计，最小化配置）：
                 落点用独立前缀 cn.perfscope.shaded.bstats —— 绝不使用 cn.perfscope.lib.*，
                 保持 v1.0.0 事故指纹前缀零命中（release-check.ps1 与 CI 门禁原样作证）。
                 与 v1.0.0 事故的前提差异：当时 relocate 的 Adventure 必须与平台 API 互操作
                 （Component 出现在 sendMessage(Component) 签名中，Paper 运行时期待 net.kyori.*，
                 改写类名即全命令 NoSuchMethodError）；bStats 是自包含遥测库，不与平台做签名级
                 互操作（官方文档即推荐 shade+relocate，且其内部 checkRelocation 字节数组技巧
                 正好认可非 org.bstats 前缀）。artifactSet 仅纳入 org.bstats 两个 artifact；
                 createDependencyReducedPom=false（不再生成 dependency-reduced-pom.xml）；
                 不加 minimizeJar；jar 名（finalName）与 manifest 不变。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>org.bstats:bstats-bukkit</include>
                                    <include>org.bstats:bstats-base</include>
                                </includes>
                            </artifactSet>
                            <relocations>
                                <relocation>
                                    <pattern>org.bstats</pattern>
                                    <shadedPattern>cn.perfscope.shaded.bstats</shadedPattern>
                                </relocation>
                            </relocations>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>
</project>
